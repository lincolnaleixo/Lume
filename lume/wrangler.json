{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lume-sync",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": { "bindings": [{ "name": "LUME_VAULT", "class_name": "LumeVault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LumeVault"] }],
  "observability": { "enabled": false }
}
